# Progetto Supabase Ronchiverdi (upoiasekisojikbzsymq): lo stesso su cui il
# sito scrive form_contatti e le sessioni, così le enquiries del pannello
# sono direttamente i lead del sito, senza sincronizzazioni.

# URL e anon key: pubbliche, usate solo per il login (Supabase Auth) lato browser.
NEXT_PUBLIC_SUPABASE_URL=https://upoiasekisojikbzsymq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Service role key: SEGRETA. Bypassa RLS, usata SOLO nei Server Component/Action.
# Su Vercel: Project Settings -> Environment Variables, NON esporre come NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# URL pubblico di produzione del pannello (senza slash finale). Serve a
# costruire il link nelle email di invito: deve corrispondere esattamente a
# una voce in Supabase Auth -> Authentication -> URL Configuration ->
# Redirect URLs, altrimenti Supabase lo ignora e il link porta altrove.
#
# ATTENZIONE: non e' app-ronchiverdi.vercel.app, che risponde 404 e non
# appartiene a questo progetto. Il progetto sta su un team Vercel (R2D) e
# l'alias di produzione generato ha il suffisso del team.
#
# Da sostituire col dominio personalizzato (es. app.ronchiverdi.it) appena
# viene collegato: e' anche l'unico modo perche' il pannello sia raggiungibile
# da chi non e' nel team Vercel — vedi il README.
NEXT_PUBLIC_SITE_URL=https://app-ronchiverdi-r2d.vercel.app

# ─────────────────────────────────────────────── Email transazionali (SendGrid)
# Chiave API SendGrid con il solo permesso "Mail Send": SEGRETA, niente
# NEXT_PUBLIC_. Serve al voucher della visita medica (email di assegnazione e
# notifica di utilizzo). Senza, il voucher viene creato lo stesso ma l'email
# non parte e resta segnata "non partita" nell'elenco, da rimandare.
SENDGRID_API_KEY=SG....

# Mittente: deve essere un indirizzo (o un dominio) verificato su SendGrid
# in Sender Authentication, altrimenti l'invio viene rifiutato con 403.
# Se non impostata vale info@ronchiverdi.it, l'indirizzo oggi verificato.
SENDGRID_FROM_EMAIL=info@ronchiverdi.it
SENDGRID_FROM_NAME=Ronchiverdi Sport Club

# Dove finiscono le risposte del socio. Oggi e' info@ (il default), ma e' una
# variabile a parte dal mittente apposta: quando i certificati avranno la loro
# casella presidiata, qui va quella, senza toccare il mittente verificato.
EMAIL_REPLY_TO=info@ronchiverdi.it

# La casella a cui il socio manda il certificato in allegato: unica modalita'
# di consegna, citata in tutte le email del voucher.
EMAIL_CERTIFICATI=certificatimedici@ronchiverdi.it

# ──────────────────────────────────────────────── Partner della visita medica
# Recapiti scritti nell'email al socio e nome che risulta come autore della
# bruciatura. In variabile d'ambiente perche' il partner e' sostituibile senza
# toccare il codice.
PARTNER_MEDICO_NOME=Chiron
PARTNER_MEDICO_TELEFONO=
PARTNER_MEDICO_EMAIL=
