# Progetto Supabase Ronchiverdi (upoiasekisojikbzsymq): lo stesso su cui il
# sito scrive form_contatti e le sessioni, così le enquiries del pannello
# sono direttamente i lead del sito, senza sincronizzazioni.

# URL e anon key: pubbliche, usate solo per il login (Supabase Auth) lato browser.
NEXT_PUBLIC_SUPABASE_URL=https://upoiasekisojikbzsymq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Service role key: SEGRETA. Bypassa RLS, usata SOLO nei Server Component/Action.
# Su Vercel: Project Settings -> Environment Variables, NON esporre come NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# URL pubblico di produzione del pannello (senza slash finale). Serve a
# costruire il link nelle email di invito: deve corrispondere esattamente a
# una voce in Supabase Auth -> Authentication -> URL Configuration ->
# Redirect URLs, altrimenti Supabase lo ignora e il link porta altrove.
NEXT_PUBLIC_SITE_URL=https://app.ronchiverdi.it
